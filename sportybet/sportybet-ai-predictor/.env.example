# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Football Data API (https://www.football-data.org/)
FOOTBALL_API_KEY=your_football_data_api_key_here

# ESPN API Configuration (optional - bot has fallback)
ESPN_API_KEY=your_espn_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./sportybet.db

# Payment Configuration (Stripe recommended)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Application Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Monitoring & Analytics (optional)
SENTRY_DSN=your_sentry_dsn_here

# Subscription Tiers Configuration
FREE_TIER_DAILY_PREDICTIONS=3
BASIC_TIER_DAILY_PREDICTIONS=10
PREMIUM_TIER_DAILY_PREDICTIONS=50
VIP_TIER_DAILY_PREDICTIONS=999

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100
