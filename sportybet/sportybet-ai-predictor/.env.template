# ============================================================================
# SPORTYBET AI BOT - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# Keep your .env file secure and never commit it to version control!

# ============================================================================
# BOT CONFIGURATION (REQUIRED)
# ============================================================================

# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram username (without @)
BOT_USERNAME=your_bot_username

# Admin user ID (get from @userinfobot on Telegram) 
ADMIN_USER_ID=your_telegram_user_id

# Admin Telegram handle (with @)
ADMIN_TELEGRAM_HANDLE=@your_admin_handle

# ============================================================================
# PAYMENT CONFIGURATION
# ============================================================================

# STRIPE PAYMENT PROCESSING
# Get these from your Stripe dashboard (https://dashboard.stripe.com/)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SUBSCRIPTION PRICING (USD)
PRO_PRICE=9.99
VIP_PRICE=29.99
PREMIUM_PRICE=99.99

# ============================================================================
# CRYPTOCURRENCY WALLET ADDRESSES
# ============================================================================

# Bitcoin wallet address (BTC)
BITCOIN_WALLET_ADDRESS=your_bitcoin_address_here

# Ethereum wallet address (ETH)  
ETHEREUM_WALLET_ADDRESS=your_ethereum_address_here

# USDT (Tether) wallet address
USDT_WALLET_ADDRESS=your_usdt_address_here

# Litecoin wallet address (LTC)
LITECOIN_WALLET_ADDRESS=your_litecoin_address_here

# Dogecoin wallet address (DOGE)
DOGECOIN_WALLET_ADDRESS=your_dogecoin_address_here

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API server URL for live data
API_SERVER_URL=http://localhost:8001

# External API keys for sports data
SPORTS_API_KEY=your_sports_api_key_here
ODDS_API_KEY=your_odds_api_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database URL (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///bot_data.db
# For PostgreSQL: postgresql://username:password@localhost/database_name

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file paths
LOG_FILE=logs/production.log
ERROR_LOG_FILE=logs/errors.log

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# JWT secret for API authentication
JWT_SECRET=your_super_secure_jwt_secret_here

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable specific features
ENABLE_PAYMENTS=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_REFERRALS=true

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000

# SSL/HTTPS settings (for production)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Domain and webhook settings
DOMAIN=your-domain.com
WEBHOOK_URL=https://your-domain.com/webhook

# ============================================================================
# EXAMPLE VALUES (REPLACE WITH YOUR OWN)
# ============================================================================

# Example bot token format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Example user ID: 123456789
# Example Bitcoin address: bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
# Example Ethereum address: 0x742D35Cc6171C4B1b4b8cBf3bC8C2d2C2C5F5F5F
# Example USDT address: TRX9ZBJyZ8jQ9K8R8q2J8K8R8Q2J8K8R8Q2J8K8R

# ============================================================================
# SECURITY NOTES
# ============================================================================

# 1. Never commit your .env file to version control
# 2. Use strong, unique passwords and secrets
# 3. Regularly rotate API keys and tokens
# 4. Enable two-factor authentication where possible
# 5. Monitor your wallets and API usage regularly
# 6. Use different addresses for different environments (test vs production)